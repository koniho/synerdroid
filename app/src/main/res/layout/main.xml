<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.Synerdroid.Headline" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/app_subtitle"
            android:textAppearance="@style/TextAppearance.Synerdroid.Supporting" />

        <TextView style="@style/Synerdroid.FieldLabel" android:text="@string/client_name" />
        <EditText
            android:id="@+id/clientNameEditText"
            style="@style/Synerdroid.EditText"
            android:hint="android"
            android:inputType="textNoSuggestions"
            android:singleLine="true" />

        <TextView style="@style/Synerdroid.FieldLabel" android:text="@string/server_address" />
        <EditText
            android:id="@+id/serverHostEditText"
            style="@style/Synerdroid.EditText"
            android:hint="@string/server_address_hint"
            android:inputType="textUri"
            android:singleLine="true" />

        <TextView style="@style/Synerdroid.FieldLabel" android:text="@string/server_port" />
        <EditText
            android:id="@+id/serverPortEditText"
            style="@style/Synerdroid.EditText"
            android:inputType="number"
            android:maxLength="5"
            android:singleLine="true"
            android:text="24800" />

        <CheckBox
            android:id="@+id/tlsCheckBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:buttonTint="@color/synergy_accent"
            android:checked="true"
            android:text="@string/use_tls" />

        <TextView style="@style/Synerdroid.FieldLabel" android:text="@string/tls_fingerprint" />
        <EditText
            android:id="@+id/tlsFingerprintEditText"
            style="@style/Synerdroid.EditText"
            android:fontFamily="monospace"
            android:hint="@string/tls_fingerprint_hint"
            android:inputType="textNoSuggestions|textCapCharacters"
            android:maxLines="3" />

        <Button
            android:id="@+id/fetchCertificateButton"
            style="@style/Synerdroid.SecondaryButton"
            android:layout_marginTop="8dp"
            android:text="@string/fetch_certificate" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/pointer_speed"
                android:textAppearance="@style/TextAppearance.Synerdroid.Section" />

            <TextView
                android:id="@+id/pointerSpeedValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.25×"
                android:textColor="@color/synergy_on_surface" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/pointerSpeedSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="150"
            android:progress="75" />

        <CheckBox
            android:id="@+id/invertScrollCheckBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/invert_scroll" />

        <Button
            android:id="@+id/accessibilityButton"
            style="@style/Synerdroid.SecondaryButton"
            android:layout_marginTop="24dp"
            android:text="@string/enable_accessibility" />

        <Button
            android:id="@+id/keyboardButton"
            style="@style/Synerdroid.SecondaryButton"
            android:layout_marginTop="12dp"
            android:text="@string/keyboard_settings" />

        <Button
            android:id="@+id/connectButton"
            style="@style/Synerdroid.PrimaryButton"
            android:layout_marginTop="12dp"
            android:text="@string/connect" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/connection_log"
            android:textAppearance="@style/TextAppearance.Synerdroid.Section" />

        <TextView
            android:id="@+id/statusTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/status_panel"
            android:fontFamily="monospace"
            android:minHeight="144dp"
            android:padding="16dp"
            android:text="@string/status_idle"
            android:textColor="@color/synergy_on_surface"
            android:textIsSelectable="true"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
